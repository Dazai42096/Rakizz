<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows previewing files saved in context.filesDir/materials/ -->
    <files-path
        name="materials"
        path="materials/" />

    <!-- Allows previewing any file saved inside context.filesDir -->
    <files-path
        name="app_files"
        path="." />

    <!-- Allows previewing temporary cached files if needed -->
    <cache-path
        name="cache_files"
        path="." />

</paths>
